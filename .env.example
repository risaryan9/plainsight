# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- bot ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Where the bot finds the API.
API_URL=http://localhost:8000

# --- api ---
# Scan reports are written to <REPORTS_DIR>/<sha256>__<PIPELINE_VERSION>.json
REPORTS_DIR=data/reports
# Part of the cache key: change it to make every APK re-scan.
PIPELINE_VERSION=dev-0
MAX_UPLOAD_MB=100
# How long a request waits for a running scan before answering 503.
SCAN_LOCK_TIMEOUT_S=20
# The Play listing and privacy policy are cached per package in <CLAIMS_DIR>/<package>.json (3 days).
CLAIMS_DIR=data/claims

# --- development only ---
# DEV-ONLY (D-035): the bot also sends extraction_<package>.json and claim_<package>.json
# to the chat after each scan. Set to false to send only the summary.
DEV_SEND_JSON=true
